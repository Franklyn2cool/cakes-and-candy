```css
/* =========================================================
   CAKES & CANDIES
   MAIN STYLESHEET
========================================================= */

:root {
    --bg: #fff7ed;
    --card: #ffffff;
    --text: #2b1b12;
    --accent: #ff8c42;
    --accent2: #ffca3a;
    --border: #e6d5c5;
    --success: #22c55e;
    --danger: #ef4444;
    --shadow: 0 5px 18px rgba(0, 0, 0, 0.08);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, Helvetica, sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    transition:
        background-color 0.25s ease,
        color 0.25s ease;
}

/* =========================================================
   GENERAL
========================================================= */

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

button:disabled {
    cursor: not-allowed;
}

h1,
h2,
h3,
h4 {
    line-height: 1.2;
}

p {
    line-height: 1.5;
}

/* =========================================================
   HEADER
========================================================= */

header {
    width: 100%;
    min-height: 78px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 15px;

    padding: 14px 25px;

    background: var(--card);

    border-bottom:
        2px solid var(--border);

    box-shadow:
        0 2px 8px rgba(0, 0, 0, 0.04);

    position: sticky;
    top: 0;
    z-index: 50;
}

.logo {
    font-size: 28px;
    font-weight: 900;
    letter-spacing: -0.5px;
}

.money {
    font-size: 21px;
    font-weight: 800;

    background: var(--bg);

    padding: 9px 14px;

    border-radius: 12px;

    border:
        1px solid var(--border);

    white-space: nowrap;
}

.settings-btn {
    border: none;

    background: var(--accent);

    color: white;

    padding: 11px 15px;

    border-radius: 12px;

    font-size: 19px;

    transition:
        transform 0.15s ease,
        opacity 0.15s ease;
}

.settings-btn:hover {
    transform: scale(1.05);
}

.settings-btn:active {
    transform: scale(0.96);
}

/* =========================================================
   NAVIGATION
========================================================= */

.nav {
    display: flex;

    justify-content: center;

    align-items: center;

    flex-wrap: wrap;

    gap: 9px;

    padding: 16px;

    background:
        color-mix(
            in srgb,
            var(--card) 92%,
            var(--bg)
        );

    border-bottom:
        1px solid var(--border);
}

.nav button {
    border: none;

    background: var(--card);

    color: var(--text);

    padding: 12px 17px;

    border-radius: 11px;

    border:
        1px solid var(--border);

    font-weight: 700;

    box-shadow:
        0 2px 6px rgba(0, 0, 0, 0.05);

    transition:
        0.15s ease;
}

.nav button:hover {
    transform: translateY(-2px);

    box-shadow:
        0 5px 12px rgba(0, 0, 0, 0.08);
}

.nav button:active {
    transform: translateY(0);
}

.nav button.active {
    background: var(--accent);

    color: white;

    border-color:
        var(--accent);

    box-shadow:
        0 5px 13px
        rgba(0, 0, 0, 0.12);
}

/* =========================================================
   MAIN CONTENT
========================================================= */

main {
    width: min(1200px, 100%);

    margin: 0 auto;

    padding:
        20px 16px 50px;
}

.page {
    display: none;

    animation:
        pageFade 0.18s ease;
}

.page.active {
    display: block;
}

@keyframes pageFade {
    from {
        opacity: 0;
        transform: translateY(4px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* =========================================================
   HOME
========================================================= */

.welcome {
    text-align: center;

    padding:
        45px 20px 30px;
}

.welcome h1 {
    font-size: clamp(32px, 5vw, 48px);

    margin-bottom: 12px;
}

.welcome p {
    max-width: 650px;

    margin: auto;

    opacity: 0.78;

    font-size: 17px;
}

.welcome::after {
    content: "🍰  🍭  🍪  🍫  🍨  🍩";

    display: block;

    font-size: 34px;

    margin-top: 22px;

    letter-spacing: 7px;
}

/* =========================================================
   MERCHANT INFORMATION
========================================================= */

.merchant-info {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 15px;

    flex-wrap: wrap;

    margin-bottom: 18px;
}

.merchant-info h2 {
    font-size: 28px;
}

.merchant-info p {
    opacity: 0.7;

    margin-top: 5px;
}

.stock-timer {
    font-weight: 800;

    padding: 11px 14px;

    background: var(--card);

    border:
        1px solid var(--border);

    border-radius: 11px;

    box-shadow:
        var(--shadow);
}

/* =========================================================
   DESSERT GRID
========================================================= */

.dessert-grid {
    display: grid;

    grid-template-columns:
        repeat(
            auto-fill,
            minmax(230px, 1fr)
        );

    gap: 16px;
}

/* =========================================================
   DESSERT CARD
========================================================= */

.dessert-card {
    background: var(--card);

    border:
        2px solid var(--border);

    border-radius: 17px;

    padding: 18px;

    box-shadow:
        var(--shadow);

    transition:
        transform 0.18s ease,
        box-shadow 0.18s ease,
        border-color 0.18s ease;
}

.dessert-card:hover {
    transform: translateY(-4px);

    box-shadow:
        0 10px 25px
        rgba(0, 0, 0, 0.1);
}

.dessert-icon {
    font-size: 50px;

    line-height: 1;

    margin-bottom: 11px;
}

.dessert-name {
    font-size: 20px;

    font-weight: 800;

    margin-bottom: 4px;
}

.rarity {
    font-weight: 800;

    margin-top: 3px;
}

.common {
    color: #777777;
}

.uncommon {
    color: #159947;
}

.rare {
    color: #2563eb;
}

.legendary {
    color: #a855f7;
}

.price {
    margin-top: 11px;

    font-size: 16px;

    font-weight: 800;
}

.value {
    margin-top: 5px;

    font-size: 14px;

    opacity: 0.8;
}

.stock {
    margin-top: 5px;

    font-size: 14px;

    font-weight: 700;
}

/* =========================================================
   BUY BUTTON
========================================================= */

.buy-row {
    display: flex;

    gap: 8px;

    margin-top: 14px;
}

.buy-btn,
.pack-btn,
.small-btn {
    border: none;

    background: var(--accent);

    color: white;

    font-weight: 800;

    border-radius: 10px;

    transition:
        transform 0.12s ease,
        opacity 0.12s ease;
}

.buy-btn {
    width: 100%;

    padding: 11px;
}

.buy-btn:hover,
.pack-btn:hover,
.small-btn:hover {
    transform: translateY(-1px);

    opacity: 0.94;
}

.buy-btn:active,
.pack-btn:active,
.small-btn:active {
    transform: scale(0.98);
}

.buy-btn:disabled,
.pack-btn:disabled {
    opacity: 0.45;
}

/* =========================================================
   PACK CARDS
========================================================= */

.pack-card {
    background: var(--card);

    border:
        2px solid var(--border);

    border-radius: 18px;

    padding: 20px;

    margin-bottom: 15px;

    box-shadow:
        var(--shadow);

    transition:
        transform 0.18s ease;
}

.pack-card:hover {
    transform: translateY(-2px);
}

.pack-title {
    font-size: 23px;

    font-weight: 900;

    margin-bottom: 5px;
}

.pack-description {
    margin:
        8px 0;

    opacity: 0.8;
}

.pack-contents {
    font-size: 14px;

    margin-bottom: 9px;

    opacity: 0.8;
}

.pack-price {
    font-size: 18px;

    font-weight: 900;

    margin-bottom: 12px;
}

.pack-btn {
    padding: 12px 17px;

    width: 100%;
}

/* =========================================================
   INVENTORY
========================================================= */

.inventory-card {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 15px;

    flex-wrap: wrap;

    background: var(--card);

    border:
        2px solid var(--border);

    border-radius: 15px;

    padding: 15px 17px;

    margin-bottom: 10px;

    box-shadow:
        0 3px 12px
        rgba(0, 0, 0, 0.05);
}

.inventory-left {
    display: flex;

    align-items: center;

    gap: 13px;

    min-width: 0;
}

.inventory-icon {
    font-size: 36px;

    flex-shrink: 0;
}

.inventory-name {
    font-size: 18px;

    font-weight: 800;

    word-break: break-word;
}

.mutation {
    display: inline-block;

    margin-top: 5px;

    font-size: 12px;

    font-weight: 800;

    padding: 4px 8px;

    border-radius: 7px;

    background:
        var(--accent2);

    color:
        #3c2500;
}

/* =========================================================
   PANTRY
========================================================= */

.pantry-slots {
    display: inline-block;

    margin:
        10px 0 18px;

    font-weight: 800;

    padding: 9px 12px;

    background: var(--card);

    border:
        1px solid var(--border);

    border-radius: 9px;
}

.favorite-btn {
    border: none;

    background: var(--accent2);

    color: #351e00;

    padding: 9px 12px;

    border-radius: 9px;

    font-weight: 800;

    transition:
        transform 0.12s ease;
}

.favorite-btn:hover {
    transform: translateY(-1px);
}

/* =========================================================
   EMPTY STATE
========================================================= */

.empty {
    text-align: center;

    padding: 65px 15px;

    opacity: 0.6;

    font-size: 18px;
}

/* =========================================================
   SELL
========================================================= */

.sell-btn {
    border: none;

    background: var(--success);

    color: white;

    padding: 10px 16px;

    border-radius: 10px;

    font-weight: 800;

    transition:
        transform 0.12s ease,
        opacity 0.12s ease;
}

.sell-btn:hover {
    transform: translateY(-1px);

    opacity: 0.92;
}

.sell-btn:active {
    transform: scale(0.98);
}

/* =========================================================
   SETTINGS OVERLAY
========================================================= */

.overlay {
    display: none;

    position: fixed;

    inset: 0;

    z-index: 100;

    padding: 20px;

    overflow-y: auto;

    background:
        rgba(0, 0, 0, 0.48);

    backdrop-filter:
        blur(3px);
}

.overlay.show {
    display: flex;

    justify-content: center;

    align-items: flex-start;
}

.modal {
    width:
        min(720px, 100%);

    margin-top: 35px;

    background: var(--card);

    color: var(--text);

    border-radius: 21px;

    padding: 25px;

    box-shadow:
        0 18px 55px
        rgba(0, 0, 0, 0.3);

    animation:
        modalOpen 0.18s ease;
}

@keyframes modalOpen {
    from {
        opacity: 0;
        transform: translateY(-8px) scale(0.99);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.modal-header {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 10px;

    margin-bottom: 12px;
}

.modal-header h2 {
    font-size: 27px;
}

.close-btn {
    border: none;

    background: transparent;

    color: var(--text);

    font-size: 27px;

    line-height: 1;

    padding: 3px 7px;

    border-radius: 8px;
}

.close-btn:hover {
    background: var(--bg);
}

/* =========================================================
   SETTINGS SECTIONS
========================================================= */

.setting-section {
    padding:
        17px 0;

    border-top:
        1px solid var(--border);
}

.setting-section h3 {
    font-size: 18px;

    margin-bottom: 11px;
}

.setting-section p {
    opacity: 0.78;
}

.setting-row {
    display: flex;

    align-items: center;

    gap: 10px;

    flex-wrap: wrap;

    margin: 9px 0;
}

.setting-row label {
    font-weight: 700;

    min-width: 85px;
}

.setting-row input[type="text"],
.setting-row input[type="email"],
.setting-row select {
    flex: 1;

    min-width: 190px;

    padding: 10px 11px;

    border:
        1px solid var(--border);

    border-radius: 9px;

    outline: none;

    background: var(--bg);

    color: var(--text);

    transition:
        border-color 0.15s ease,
        box-shadow 0.15s ease;
}

.setting-row input[type="text"]:focus,
.setting-row input[type="email"]:focus,
.setting-row select:focus {
    border-color:
        var(--accent);

    box-shadow:
        0 0 0 3px
        rgba(255, 140, 66, 0.12);
}

.setting-row input[type="color"] {
    width: 58px;

    height: 38px;

    border: none;

    padding: 0;

    background: transparent;

    cursor: pointer;
}

.setting-row input[type="range"] {
    flex: 1;

    min-width: 180px;

    accent-color:
        var(--accent);

    cursor: pointer;
}

.small-btn {
    padding: 10px 14px;

    white-space: nowrap;
}

/* =========================================================
   SONG LIST
========================================================= */

.song-list {
    margin-top: 13px;
}

.song {
    display: flex;

    align-items: center;

    gap: 10px;

    padding: 10px 12px;

    background: var(--bg);

    border:
        1px solid var(--border);

    border-radius: 9px;

    margin-bottom: 7px;

    transition:
        transform 0.12s ease;
}

.song:hover {
    transform: translateX(2px);
}

.song span {
    min-width: 0;

    flex: 1;

    line-height: 1.4;
}

.song button {
    flex-shrink: 0;

    border: none;

    border-radius: 8px;

    padding: 7px 10px;

    background: var(--accent);

    color: white;

    font-weight: 800;
}

/* =========================================================
   ACCOUNT
========================================================= */

.login-box {
    width:
        min(500px, 100%);

    margin:
        30px auto;

    background: var(--card);

    border:
        2px solid var(--border);

    padding: 25px;

    border-radius: 18px;

    box-shadow:
        var(--shadow);
}

.login-box h2 {
    margin-bottom: 8px;
}

.login-box input {
    width: 100%;

    margin:
        7px 0;

    padding:
        12px 13px;

    border:
        1px solid var(--border);

    border-radius: 9px;

    outline: none;

    background: var(--bg);

    color: var(--text);
}

.login-box input:focus {
    border-color:
        var(--accent);

    box-shadow:
        0 0 0 3px
        rgba(255, 140, 66, 0.12);
}

.login-box .small-btn {
    margin-top: 8px;
}

/* =========================================================
   TOAST
========================================================= */

.toast {
    position: fixed;

    right: 20px;

    bottom: 20px;

    max-width:
        min(390px, calc(100vw - 40px));

    background:
        #222;

    color:
        #fff;

    padding:
        13px 17px;

    border-radius:
        11px;

    box-shadow:
        0 8px 25px
        rgba(0, 0, 0, 0.22);

    opacity: 0;

    transform:
        translateY(8px);

    pointer-events: none;

    transition:
        opacity 0.2s ease,
        transform 0.2s ease;

    z-index: 200;
}

.toast.show {
    opacity: 1;

    transform:
        translateY(0);
}

/* =========================================================
   SCROLLBAR
========================================================= */

::-webkit-scrollbar {
    width: 10px;
}

::-webkit-scrollbar-track {
    background: var(--bg);
}

::-webkit-scrollbar-thumb {
    background:
        var(--border);

    border-radius: 20px;
}

::-webkit-scrollbar-thumb:hover {
    background:
        var(--accent);
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {

    header {
        padding:
            12px 14px;

        min-height:
            70px;
    }

    .logo {
        font-size: 20px;
    }

    .money {
        font-size: 15px;

        padding:
            8px 9px;
    }

    .settings-btn {
        padding:
            9px 11px;
    }

    .nav {
        padding: 10px;

        gap: 7px;
    }

    .nav button {
        font-size: 13px;

        padding:
            9px 11px;
    }

    main {
        padding:
            14px 11px 40px;
    }

    .welcome {
        padding:
            30px 8px 22px;
    }

    .welcome p {
        font-size: 15px;
    }

    .welcome::after {
        font-size: 25px;

        letter-spacing: 3px;
    }

    .merchant-info h2 {
        font-size: 23px;
    }

    .dessert-grid {
        grid-template-columns:
            repeat(
                auto-fill,
                minmax(180px, 1fr)
            );

        gap: 11px;
    }

    .dessert-card {
        padding:
            14px;
    }

    .dessert-icon {
        font-size: 41px;
    }

    .dessert-name {
        font-size: 17px;
    }

    .inventory-card {
        align-items:
            flex-start;
    }

    .inventory-left {
        width: 100%;
    }

    .inventory-card > button {
        width: 100%;
    }

    .modal {
        padding:
            18px;

        margin-top:
            10px;
    }

    .setting-row {
        align-items:
            stretch;
    }

    .setting-row label {
        width: 100%;
    }

    .setting-row input[type="range"] {
        min-width: 150px;
    }

    .song {
        align-items:
            flex-start;
    }

    .song button {
        padding:
            7px 9px;
    }
}

/* =========================================================
   VERY SMALL PHONES
========================================================= */

@media (max-width: 430px) {

    .logo {
        font-size: 17px;
    }

    .money {
        font-size: 13px;
    }

    .settings-btn {
        font-size: 16px;
    }

    .nav button {
        flex:
            1 1 calc(50% - 8px);

        text-align: center;
    }

    .dessert-grid {
        grid-template-columns:
            1fr;
    }

    .merchant-info {
        align-items:
            flex-start;
    }

    .stock-timer {
        width: 100%;

        text-align: center;
    }
}
```
