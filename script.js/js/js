    });
}

function selectSong(index) {

    currentSongIndex = index;

    document.getElementById("currentSong")
        .textContent =
        songs[index].name;

    if (musicPlaying) {
        playCurrentSong();
    }
}

function toggleMusic() {

    musicPlaying = !musicPlaying;

    const button =
        document.getElementById("musicToggle");

    if (musicPlaying) {

        button.textContent = "⏸ Pause";

        playCurrentSong();

    } else {

        button.textContent = "▶ Play";

        if (audio) {
            audio.pause();
        }
    }
}

function playCurrentSong() {
    const song = songs[currentSongIndex];
    const source = audioSources[song.name];

    document.getElementById("currentSong").textContent = song.name;

    if (!source) {
        showToast(`${song.name} is selected, but its authorized audio file is not installed.`);
        musicPlaying = false;
        const button = document.getElementById("musicToggle");
        if (button) button.textContent = "▶ Play";
        return;
    }

    if (audio) {
        audio.pause();
        audio.currentTime = 0;
    }

    audio = new Audio(source);
    audio.preload = "auto";
    audio.volume = Number(document.getElementById("musicVolume").value) / 100;

    audio.play().then(() => {
        musicPlaying = true;
        const button = document.getElementById("musicToggle");
        if (button) button.textContent = "⏸ Pause";
    }).catch(() => {
        musicPlaying = false;
        const button = document.getElementById("musicToggle");
        if (button) button.textContent = "▶ Play";
        showToast("The browser blocked playback or the audio file could not be loaded.");
    });

    audio.onended = () => nextSong();
}

function nextSong() {

    currentSongIndex++;

    if (currentSongIndex >= songs.length) {
        currentSongIndex = 0;
    }

    document.getElementById("currentSong")
        .textContent =
        songs[currentSongIndex].name;

    if (musicPlaying) {
        playCurrentSong();
    }
}

function previousSong() {

    currentSongIndex--;

    if (currentSongIndex < 0) {
        currentSongIndex = songs.length - 1;
    }

    document.getElementById("currentSong")
        .textContent =
        songs[currentSongIndex].name;

    if (musicPlaying) {
        playCurrentSong();
    }
}

function shuffleSongs() {

    currentSongIndex =
        randomInt(0, songs.length - 1);

    document.getElementById("currentSong")
        .textContent =
        songs[currentSongIndex].name;

    if (musicPlaying) {
        playCurrentSong();
    }
}

function addCustomSong() {

    if (!signedIn) {
        showToast("You must sign in to add a custom song.");
        return;
    }

    const input =
        document.getElementById("songIdInput");

