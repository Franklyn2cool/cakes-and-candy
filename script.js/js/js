/* Stats */
function getMostLeastBought() {
    const entries = desserts
        .map(d => [d, Number(stats.dessertsBought[d.id] || 0)])
        .filter(([, count]) => count > 0);

    if (!entries.length) return { most: "None yet", least: "None yet" };

    entries.sort((a, b) => b[1] - a[1]);

    return {
        most: `${entries[0][0].name} (${entries[0][1]})`,
        least: `${entries[entries.length - 1][0].name} (${entries[entries.length - 1][1]})`
    };
}

function formatPlayTime(seconds) {
    seconds = Math.max(0, Math.floor(seconds));
    const days = Math.floor(seconds / 86400);
    seconds %= 86400;
    const hours = Math.floor(seconds / 3600);
    seconds %= 3600;
    const minutes = Math.floor(seconds / 60);
    const secs = seconds % 60;

    const parts = [];
    if (days) parts.push(`${days}d`);
    if (hours) parts.push(`${hours}h`);
    if (minutes) parts.push(`${minutes}m`);
    parts.push(`${secs}s`);
    return parts.join(" ");
}

function updatePlayTime() {
    const now = Date.now();
    const elapsed = Math.floor((now - playSessionStartedAt) / 1000);
    if (elapsed <= 0) return;

    totalPlaySeconds += elapsed;
    todayPlaySeconds += elapsed;
    weekPlaySeconds += elapsed;
    playSessionStartedAt = now;

    const day = new Date().toISOString().slice(0, 10);
    const week = getWeekKey(new Date());

    if (day !== lastPlayDay) {
        todayPlaySeconds = 0;
        lastPlayDay = day;
    }
    if (week !== lastPlayWeek) {
        weekPlaySeconds = 0;
        lastPlayWeek = week;
    }
}

