            <div class="price">Buy: $${formatMoney(dessert.price)}</div>
            <div class="value">Value: $${formatMoney(dessert.minValue)} - $${formatMoney(dessert.maxValue)}</div>
            <div class="stock">Stock: ${stock}</div>
            <div class="buy-row">
                <button class="buy-btn" ${stock <= 0 ? "disabled" : ""} onclick="buyDessert('${dessert.id}')">Buy 1</button>
            </div>
        `;
        grid.appendChild(card);
    });

    if (!mythicUnlocked) {
        grid.insertAdjacentHTML("beforeend", `
            <div class="unlock-card">
                <div class="dessert-icon">🌟</div>
                <h3>Mythic Locked</h3>
                <p>Reach $50,000,000 and Rebirth once to unlock Crepes, Popcorn and Strawberry Short Cake.</p>
            </div>
        `);
    }
};

const _oldRenderPacks = renderPacks;
renderPacks = function() {
    const container = document.getElementById("packsGrid");
    if (!container) return;

    container.innerHTML = "";

    desserts.forEach(dessert => {
        if (dessert.mythic && !mythicUnlocked) return;

        const available = packStock[dessert.id] !== false;
        const rarityClass = dessert.rarity.toLowerCase();
        const card = document.createElement("div");
        card.className = "pack-card";

        card.innerHTML = `
            <div class="pack-title">${dessert.icon} ${dessert.name} Pack</div>
            <div class="rarity ${rarityClass}">${dessert.rarity}</div>
            <div class="pack-description">
                Receive between <strong>${dessert.packMin}</strong> and <strong>${dessert.packMax}</strong> ${dessert.name}${dessert.packMax === 1 ? "" : "s"}.
            </div>
            <div class="pack-contents">Possible amount: ${dessert.packMin}-${dessert.packMax}</div>
            <div class="pack-price">Pack Price: $${formatMoney(dessert.packPrice)}</div>
            <button class="pack-btn" ${available ? "" : "disabled"} onclick="buyPack('${dessert.id}')">
                ${available ? "Buy Pack" : "Sold Out"}
            </button>
        `;
        container.appendChild(card);
    });

    if (!mythicUnlocked) {
        container.insertAdjacentHTML("beforeend", `
            <div class="unlock-card">
                <div class="dessert-icon">📦</div>
                <h3>Mythic Packs Locked</h3>
                <p>First Rebirth unlocks all Mythic packs.</p>
            </div>
        `);
    }
};

/* Add saved custom songs to the soundtrack list. */
function rebuildSongList() {
    songs.length = 0;
    const defaults = [
        ["Classic Easter", "AXS Music"],
        ["Gymnopédie No. 1", "Erik Satie"],
        ["Wedding Cocktail", "AXS Music"],
        ["Do I Clench My Fists?", "Ridgeclub"],
        ["Tropical Breeze", "The Puahia Street Players"],
        ["Beginning Of The Dream", "AZALI"],
        ["Orchestral Practice", "AZALI"],
        ["Rematch", "AZALI"],
        ["Gold", "Koven"]
    ];

    defaults.forEach(([name, artist]) => songs.push({ name, artist }));
    customSongs.forEach(song => songs.push(song));
}

const _oldAddCustomSong = addCustomSong;
addCustomSong = function() {
    if (!signedIn) {
        showToast("You must sign in to add a custom song.");
        return;
    }

    const input = document.getElementById("songIdInput");
    const id = input.value.trim();

    if (!id) {
        showToast("Enter an authorized song ID.");
        return;
    }

    if (!authorizedSongIds.has(id)) {
        showToast("That song ID is not in your authorized song list.");
        return;
    }

    const songInfo = (window.AUTHORIZED_SONGS || []).find(s => s.id === id);
    if (!songInfo) {
        showToast("Authorized song not found.");
        return;
    }

    customSongs.push({
        name: songInfo.name,
        artist: songInfo.artist,
        id: songInfo.id
    });

    audioSources[songInfo.name] = songInfo.src;
    rebuildSongList();
    renderSongs();
    saveGame();

    input.value = "";
    showToast("🎵 Authorized custom song added!");
};

/* Settings saved values */
const _oldChangeMusicVolume = changeMusicVolume;
changeMusicVolume = function(value) {
    _oldChangeMusicVolume(value);
    if (audio) audio.volume = Number(value) / 100;
};

/* Enhanced account sign-in for the current frontend demo. */
const _oldSignIn = signIn;
signIn = function() {
    const email = document.getElementById("loginEmail").value.trim();
    const name = document.getElementById("loginName").value.trim();

    if (!email || !name) {
        showToast("Enter your username and email.");
        return;
    }

    const wasSignedIn = signedIn;
    signedIn = true;
    username = name;

    const status = document.getElementById("accountStatus");
    if (status) status.textContent = `✅ Signed in as ${username}`;

    if (!wasSignedIn) grantRealOneReward();
    checkBadges();
    saveGame();

    renderInventory();
    renderSell();
    renderStats();
    showToast(wasSignedIn ? "Signed-in profile updated!" : "Signed in!");
};

