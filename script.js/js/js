function getWeekKey(date) {
    const d = new Date(date);
    const first = new Date(d.getFullYear(), 0, 1);
    const day = Math.floor((d - first) / 86400000);
    return `${d.getFullYear()}-W${Math.ceil((day + first.getDay() + 1) / 7)}`;
}

function mergeStats(oldStats) {
    const merged = cloneDefaults();
    if (oldStats && typeof oldStats === "object") {
        Object.keys(merged).forEach(key => {
            if (key === "dessertsBought" || key === "dessertsObtained") {
                merged[key] = { ...merged[key], ...(oldStats[key] || {}) };
            } else if (typeof oldStats[key] === "number") {
                merged[key] = oldStats[key];
            }
        });
    }
    return merged;
}

