function addRewardPack(rarity) {
    const possible = desserts.filter(d => d.rarity === rarity && (!d.mythic || mythicUnlocked));
    if (!possible.length) return;

    const dessert = possible[randomInt(0, possible.length - 1)];
    ownedRewardPacks.push({
        id: dessert.id,
        name: `${dessert.name} Pack`,
        rarity: dessert.rarity,
        receivedAt: Date.now()
    });

    renderMinigames();
}

function openRewardPack(index) {
    const pack = ownedRewardPacks[index];
    if (!pack) return;

    const amount = randomInt(getDessert(pack.id).packMin, getDessert(pack.id).packMax);
    for (let i = 0; i < amount; i++) inventory.push(createDessert(pack.id));

    ownedRewardPacks.splice(index, 1);
    stats.packsBought += 1;
    renderInventory();
    renderSell();
    renderMinigames();
    saveGame();

    showToast(`📦 Minigame pack opened! You got ${amount} ${getDessert(pack.id).name}${amount === 1 ? "" : "s"}!`);
}

